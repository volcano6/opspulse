# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF on shell scripts, Go source, configs, and documentation
*.sh text eol=lf
*.go text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.md text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
